flowchart TB
    subgraph Frontends["Frontend / External Consumers"]
        direction LR
        Tauri["Tauri WebView"]
        Browser["Browser<br/>(Local / GitHub Pages)"]
        External["External Applications<br/>C / C++ / C# / other"]
    end

    subgraph ApplicationBoundaries["Application Boundary"]
        direction LR
        TauriCommand["Tauri Commands<br/>IPC / invoke()"]
        HttpServer["whitebase-server<br/>HTTP + JSON"]
        Wasm["whitebase-wasm<br/>WebAssembly"]
        CApi["whitebase-c-api<br/>C ABI"]
    end

    Runner["whitebase-runner<br/>入力生成・ウォームアップ<br/>計測・結果比較・レポート生成"]

    Core["whitebase-core<br/>Backend登録・指定実行<br/>能力・可用性確認・統一計算API"]

    Interface["whitebase-backend-contract<br/>BackendKind / Capabilities<br/>ComputeBackend / Error"]

    Bridge["whitebase-backend-bridge<br/>各Backendを共通Interfaceへ統合"]

    subgraph BackendConnections["Backend Implementations / Bindings"]
        direction LR

        RustBackend["whitebase-rust-backend<br/>Rust Scalar / SIMD<br/>x86_64 AVX / wasm32 SIMD128"]

        CppAdapter["whitebase-cpp-adapter<br/>Rust → C++ FFI"]

        AssemblyAdapter["whitebase-asm-adapter<br/>Rust → Assembly FFI"]

        WindowsGnuAdapter["whitebase-windows-gnu-adapter<br/>Windows GNU native binding"]

        Unavailable["unavailable<br/>非対応環境用Backend"]
    end

    subgraph NativeLibraries["Native Libraries"]
        direction LR

        MsvcNative["Windows x64 / MSVC<br/>C++ / MASM<br/>Scalar / AVX"]

        LinuxNative["Linux x86_64 / GNU<br/>GCC / NASM<br/>Scalar / AVX"]

        WindowsGnuNative["Windows x64 / GNU<br/>GCC / NASM<br/>Scalar / AVX"]
    end

    %% --------------------------------------------------------
    %% Entry routes
    %% --------------------------------------------------------

    Tauri -->|"invoke()"| TauriCommand

    Browser -->|"Server available: HTTP"| HttpServer
    Browser -->|"Server unavailable: WebAssembly"| Wasm

    External -->|"C ABI"| CApi

    %% --------------------------------------------------------
    %% Application boundaries
    %% --------------------------------------------------------

    TauriCommand --> Runner
    HttpServer --> Runner

    Wasm -->|"Observation / Benchmark"| Runner
    Wasm -->|"Primitive compute API"| Core

    CApi --> Core

    %% --------------------------------------------------------
    %% Common execution path
    %% --------------------------------------------------------

    Runner --> Core
    Core --> Bridge

    Core -. "uses contract" .-> Interface
    Bridge -. "implements contract" .-> Interface

    %% --------------------------------------------------------
    %% Backend routing
    %% --------------------------------------------------------

    Bridge --> RustBackend
    Bridge --> CppAdapter
    Bridge --> AssemblyAdapter
    Bridge --> WindowsGnuAdapter
    Bridge -. "unsupported targets" .-> Unavailable

    %% --------------------------------------------------------
    %% Native implementations
    %% --------------------------------------------------------

    CppAdapter --> MsvcNative
    CppAdapter --> LinuxNative

    AssemblyAdapter --> MsvcNative
    AssemblyAdapter --> LinuxNative

    WindowsGnuAdapter --> WindowsGnuNative