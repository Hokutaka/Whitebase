flowchart TB
    %% ========================================================
    %% Presentation / Hosts
    %% ========================================================

    subgraph Presentation["L7 Presentation / Applications"]
        direction LR
        BrowserUI["whitebase-app<br/>Browser UI"]
        TauriUI["whitebase-app<br/>Tauri WebView"]
        ServerHost["whitebase-server<br/>HTTP Server Host"]
        ExternalNative["External native consumers<br/>C / C++ / C# / other"]
    end

    %% ========================================================
    %% Interface
    %% ========================================================

    subgraph Interface["L6 Interface / Application Boundary"]
        direction TB

        ApplicationInterface["whitebase-interface<br/>transport-independent Application Boundary"]

        subgraph InterfaceAdapters["Interface Adapters"]
            direction LR
            HttpApi["whitebase-http-api<br/>HTTP / JSON / Axum"]
            TauriApi["whitebase-tauri-api<br/>Tauri IPC"]
            WasmApi["whitebase-wasm<br/>WebAssembly / JavaScript"]
        end
    end

    %% ========================================================
    %% Runner / Core
    %% ========================================================

    Runner["L5 Runner<br/>whitebase-runner<br/>benchmark / comparison / observation / report"]
    Core["L4 Core<br/>whitebase-core<br/>backend registration / capability / availability / dispatch"]

    %% ========================================================
    %% Backend integration
    %% ========================================================

    subgraph Integration["L3 Backend Integration"]
        direction LR
        Bridge["whitebase-backend-bridge<br/>ComputeBackend integration"]
        CppAdapter["whitebase-cpp-adapter"]
        AsmAdapter["whitebase-asm-adapter"]
        WindowsGnuAdapter["whitebase-windows-gnu-adapter"]
        CeruneVmAdapter["whitebase-cerune-vm-adapter"]
        FutureCerune["Cerune artifact adapters<br/>C / LLVM / QBE / WAT / ASM / native object<br/>(planned)"]
    end

    BackendContract["L1 Backend Contract<br/>whitebase-backend-contract<br/>BackendKind / OperationKind / Capability / ComputeBackend / ComputeError"]

    %% ========================================================
    %% Backend implementations
    %% ========================================================

    subgraph Implementation["L2 Backend Implementation / Execution Targets"]
        direction LR
        RustBackend["whitebase-rust-backend<br/>Rust Scalar / SIMD<br/>AVX / NEON / SIMD128"]
        CppNative["C++ native implementations<br/>Scalar / AVX"]
        AsmNative["Assembly native implementations<br/>MASM / NASM<br/>Scalar / AVX"]
        WindowsGnuNative["Windows GNU native DLL<br/>GCC / NASM"]
        CeruneVm["Cerune<br/>cerune-lang / bytecode / VM"]
        ExternalToolchains["External toolchains / runtimes<br/>(future artifact routes)"]
    end

    %% ========================================================
    %% FFI boundary
    %% ========================================================

    CApi["FFI Boundary<br/>whitebase-c-api<br/>C ABI"]

    %% ========================================================
    %% Operations plane
    %% ========================================================

    subgraph Operations["Operations Plane"]
        direction LR
        Scripts["scripts<br/>build / test / run / release"]
        ControlCenter["whitebase-control-center"]
        ControlPanel["whitebase-control-panel"]
        WhitebaseWindows["Whitebase.Windows"]
    end

    %% ========================================================
    %% Application routes
    %% ========================================================

    BrowserUI -->|"server available"| ServerHost
    BrowserUI -->|"server unavailable"| WasmApi

    TauriUI -->|"invoke()"| TauriApi
    ServerHost --> HttpApi

    HttpApi --> ApplicationInterface
    TauriApi --> ApplicationInterface
    WasmApi --> ApplicationInterface

    ApplicationInterface -->|"Applied Compute"| Runner
    ApplicationInterface -->|"Pure Compute"| Core

    Runner --> Core

    ExternalNative --> CApi
    CApi --> Core

    %% ========================================================
    %% Core / contract / backend routing
    %% ========================================================

    Core --> Bridge
    Core -. "uses contract" .-> BackendContract
    Bridge -. "implements contract" .-> BackendContract

    Bridge --> RustBackend
    Bridge --> CppAdapter
    Bridge --> AsmAdapter
    Bridge --> WindowsGnuAdapter
    Bridge --> CeruneVmAdapter

    CppAdapter --> CppNative
    AsmAdapter --> AsmNative
    WindowsGnuAdapter --> WindowsGnuNative
    CeruneVmAdapter --> CeruneVm

    Bridge -. "future" .-> FutureCerune
    FutureCerune -.-> ExternalToolchains

    %% ========================================================
    %% Operations
    %% ========================================================

    Scripts -. "build / test / run" .-> Presentation
    Scripts -. "build / test" .-> Interface
    Scripts -. "build / test" .-> Runner
    Scripts -. "build / test" .-> Core
    Scripts -. "native build / test" .-> Implementation

    ControlCenter -.-> Scripts
    ControlPanel -.-> Scripts
    ControlPanel --> WhitebaseWindows

    classDef planned stroke-dasharray: 6 4
    class FutureCerune,ExternalToolchains planned
