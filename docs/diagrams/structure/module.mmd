flowchart TB
    %% ========================================================
    %% apps/
    %% ========================================================

    subgraph Apps["apps/"]
        direction LR
        App["apps/whitebase-app<br/>Browser UI + Tauri host"]
        Server["apps/whitebase-server<br/>HTTP host"]
    end

    %% ========================================================
    %% crates/interface/
    %% ========================================================

    subgraph Interface["crates/interface/"]
        direction LR
        ApplicationInterface["whitebase-interface<br/>Application Boundary"]
        HttpApi["whitebase-http-api<br/>HTTP / JSON / Axum Adapter"]
        TauriApi["whitebase-tauri-api<br/>Tauri IPC Adapter"]
        WasmApi["whitebase-wasm<br/>WebAssembly Adapter"]
    end

    %% ========================================================
    %% crates/compute/
    %% ========================================================

    subgraph Compute["crates/compute/"]
        direction LR
        Runner["whitebase-runner<br/>benchmark / comparison / observation"]
        Core["whitebase-core<br/>registration / dispatch / compute API"]
    end

    %% ========================================================
    %% crates/backend/
    %% ========================================================

    subgraph Backend["crates/backend/"]
        direction TB

        Contract["whitebase-backend-contract<br/>common contract / types / errors / capabilities"]

        RustBackend["whitebase-rust-backend<br/>Rust Scalar / SIMD"]

        subgraph BackendIntegration["integration/"]
            direction LR
            Bridge["whitebase-backend-bridge"]
            CppAdapter["whitebase-cpp-adapter"]
            AsmAdapter["whitebase-asm-adapter"]
            WindowsGnuAdapter["whitebase-windows-gnu-adapter"]
            CeruneVmAdapter["whitebase-cerune-vm-adapter"]
        end
    end

    %% ========================================================
    %% crates/ffi/
    %% ========================================================

    subgraph FFI["crates/ffi/"]
        CApi["whitebase-c-api<br/>C ABI"]
    end

    %% ========================================================
    %% native/
    %% ========================================================

    subgraph Native["native/"]
        direction LR
        NativeCpp["Whitebase.Cpp<br/>Windows MSVC C++ / MASM"]
        NativeLinux["Whitebase.Linux<br/>Linux GCC / NASM"]
        NativeWindowsGnu["Whitebase.Windows.Gnu<br/>Windows GCC / NASM"]
    end

    %% ========================================================
    %% external dependency
    %% ========================================================

    Cerune["Hokutaka/Cerune<br/>cerune-lang<br/>bytecode / VM"]

    %% ========================================================
    %% tools/
    %% ========================================================

    subgraph Tools["tools/"]
        direction LR
        ControlCenter["whitebase-control-center"]
        ControlPanel["whitebase-control-panel"]
        WhitebaseWindows["Whitebase.Windows"]
    end

    Scripts["scripts/<br/>operations / build / test / run / release"]

    %% ========================================================
    %% Application / interface routes
    %% ========================================================

    App -->|"Tauri"| TauriApi
    App -->|"Browser + Server"| Server
    App -->|"Browser + WASM"| WasmApi

    Server --> HttpApi

    HttpApi --> ApplicationInterface
    TauriApi --> ApplicationInterface
    WasmApi --> ApplicationInterface

    ApplicationInterface --> Runner
    ApplicationInterface --> Core
    Runner --> Core

    %% ========================================================
    %% Core / backend dependencies
    %% ========================================================

    Core --> Bridge
    Core --> Contract
    Bridge --> Contract

    Bridge --> RustBackend
    Bridge --> CppAdapter
    Bridge --> AsmAdapter
    Bridge --> WindowsGnuAdapter
    Bridge --> CeruneVmAdapter

    CppAdapter --> NativeCpp
    CppAdapter --> NativeLinux

    AsmAdapter --> NativeCpp
    AsmAdapter --> NativeLinux

    WindowsGnuAdapter --> NativeWindowsGnu
    CeruneVmAdapter --> Cerune

    %% ========================================================
    %% FFI
    %% ========================================================

    CApi --> Core

    %% ========================================================
    %% Operations
    %% ========================================================

    ControlCenter -.-> Scripts
    ControlPanel -.-> Scripts
    ControlPanel --> WhitebaseWindows

    Scripts -. "build / test" .-> Apps
    Scripts -. "build / test" .-> Interface
    Scripts -. "build / test" .-> Compute
    Scripts -. "build / test" .-> Backend
    Scripts -. "native build / test" .-> Native
