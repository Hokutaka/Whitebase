flowchart TB
    subgraph Apps["Applications"]
        direction LR
        Web["whitebase-app<br/>Web UI<br/>(Browser runtime)"]
        TauriApp["whitebase-app<br/>Tauri Application"]
        Server["whitebase-server<br/>HTTP Server Host"]
        CppClient["Whitebase.CppClient<br/>C ABI smoke test"]
        CppBackendClient["Whitebase.CppBackendClient<br/>C++ Backend smoke test"]
        AssemblyClient["Whitebase.AssemblyClient<br/>Assembly smoke test"]
        External["External Applications<br/>C# / C++ / other"]
    end

    subgraph Consumers["Interface Adapters / Entry Points"]
        direction LR
            HttpApi["whitebase-http-api<br/>HTTP / JSON / Axum Adapter"]
            Wasm["whitebase-wasm<br/>WebAssembly boundary"]
            TauriApi["whitebase-tauri-api<br/>Tauri Command / IPC Adapter"]
            CApi["whitebase-c-api<br/>C ABI boundary"]
    end

    ApplicationInterface["whitebase-interface<br/>Application Boundary<br/>Pure Compute / Applied Compute<br/>Request / Response / InterfaceError"]

    BackendContract["whitebase-backend-contract<br/>trait / common types / errors<br/>capabilities / operation kinds"]

    Runner["whitebase-runner<br/>input generation / warmup / timing<br/>comparison / report generation"]

    Core["whitebase-core<br/>backend registration / dispatch<br/>capability / availability / compute API"]

    Bridge["whitebase-backend-bridge<br/>connects Backends to common Backend Contract"]

    subgraph Backends["Backend implementations / bindings"]
        direction LR
        RustBackend["whitebase-rust-backend<br/>Rust Scalar / SIMD<br/>x86_64 AVX / AArch64 NEON / wasm32 SIMD128"]
        CppAdapter["whitebase-cpp-adapter<br/>Rust → C++ FFI"]
        AsmAdapter["whitebase-asm-adapter<br/>Rust → Assembly FFI"]
        WindowsGnuAdapter["whitebase-windows-gnu-adapter<br/>Rust → Windows GNU native DLL"]
        Unavailable["unavailable backend<br/>unsupported-target fallback"]
    end

    subgraph Native["Native libraries"]
        direction TB

        subgraph WindowsMsvc["Windows x64 / MSVC"]
            direction LR
            CppLib["Whitebase.CppBackend.lib<br/>C++ Scalar / AVX"]
            AsmLib["Whitebase.Assembly.lib<br/>MASM x64 Scalar / AVX"]
        end

        subgraph LinuxGnu["Linux x86_64 / GNU"]
            direction LR
            LinuxCppLib["libwhitebase_cpp_backend.a<br/>GCC Scalar / AVX"]
            LinuxAsmLib["libwhitebase_assembly.a<br/>NASM Scalar / AVX"]
        end

        subgraph WindowsGnu["Windows x64 / GNU"]
            direction LR
            WindowsGnuLib["whitebase_windows_gnu_native.dll<br/>GCC / NASM<br/>Scalar / AVX"]
        end
    end

    subgraph Analysis["Analysis / Output"]
        direction LR
        Visualization["whitebase-visualization<br/>tables / charts / rendering"]
        OutputModule["whitebase-output<br/>CSV / JSON output"]
        Artifacts["output data<br/>CSV / JSON / measurements"]
        Python["Python tools<br/>additional analysis / visualization"]
    end

    subgraph Tools["Development tools"]
        direction LR

        Scripts["scripts<br/>ops.bat / linux-native.sh<br/>windows-gnu-native.ps1"]

        ControlCenter["whitebase-control-center<br/>Rust + egui operation tool"]

        subgraph Operation["Operation / Control Panel"]
            direction LR
            ControlPanel["whitebase-control-panel<br/>Windows GUI operation panel"]
            WhitebaseWindows["Whitebase.Windows<br/>Win32 API / process control"]
        end
    end

    %% --------------------------------------------------------
    %% Application routes
    %% --------------------------------------------------------

    Web -->|"Server available: HTTP"| Server
    Web -->|"Server unavailable: WebAssembly"| Wasm

    TauriApp -->|"IPC / invoke()"| TauriApi
    TauriApi --> ApplicationInterface

    CppClient --> CApi
    External --> CApi

    CppBackendClient --> CppLib
    AssemblyClient --> AsmLib

    %% --------------------------------------------------------
    %% Interface Adapters → Application Boundary
    %% --------------------------------------------------------

    Server --> HttpApi

    HttpApi --> ApplicationInterface
    TauriCommands --> ApplicationInterface
    Wasm --> ApplicationInterface

    %% --------------------------------------------------------
    %% Application Boundary → Runner / Core
    %% --------------------------------------------------------

    ApplicationInterface -->|"Applied Compute"| Runner
    ApplicationInterface -->|"Pure Compute"| Core

    CApi --> Core

    Runner --> Core

    %% --------------------------------------------------------
    %% Core / Backend Contract / Backend routing
    %% --------------------------------------------------------

    Core --> Bridge
    Core -. "uses contract" .-> BackendContract
    Bridge -. "implements contract" .-> BackendContract

    Bridge --> RustBackend
    Bridge --> CppAdapter
    Bridge --> AsmAdapter
    Bridge --> WindowsGnuAdapter
    Bridge -. "unsupported targets" .-> Unavailable

    %% --------------------------------------------------------
    %% Native backend bindings
    %% --------------------------------------------------------

    CppAdapter -->|"Windows MSVC"| CppLib
    CppAdapter -->|"Linux GNU"| LinuxCppLib

    AsmAdapter -->|"Windows MSVC"| AsmLib
    AsmAdapter -->|"Linux GNU"| LinuxAsmLib

    WindowsGnuAdapter --> WindowsGnuLib

    %% --------------------------------------------------------
    %% Planned analysis / output
    %% --------------------------------------------------------

    Runner -. "planned: report" .-> Visualization
    Runner -. "planned: report" .-> OutputModule
    OutputModule -. "planned: generates" .-> Artifacts
    Python -. "planned: reads / analyzes" .-> Artifacts

    %% --------------------------------------------------------
    %% Development tools
    %% --------------------------------------------------------

    Scripts -. "build / test" .-> ApplicationInterface
    Scripts -. "build / test" .-> Runner
    Scripts -. "build / test" .-> Core
    Scripts -. "build / test" .-> Backends
    Scripts -. "native build / test" .-> Native
    Scripts -. "smoke test" .-> CppClient
    Scripts -. "smoke test" .-> CppBackendClient
    Scripts -. "smoke test" .-> AssemblyClient
    Scripts -. "run / release" .-> Server
    Scripts -. "build / release" .-> TauriApp
    Scripts -. "build" .-> Wasm

    ControlCenter -. "operation / check / build" .-> Scripts
    ControlPanel -. "operation / check / build" .-> Scripts
    ControlPanel -->|"Win32 interop / process control"| WhitebaseWindows

    classDef planned stroke-dasharray: 6 4
    class Visualization,OutputModule,Artifacts,Python planned
