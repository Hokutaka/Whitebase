flowchart TB
    subgraph Apps["Applications"]
        direction LR
        Web["whitebase-app<br/>Web UI<br/>(Browser runtime)"]
        TauriApp["whitebase-app<br/>Tauri Application"]
        Server["whitebase-server<br/>ローカルHTTP API"]
        CppClient["Whitebase.CppClient<br/>C ABIスモークテスト"]
        CppBackendClient["Whitebase.CppBackendClient<br/>C++ Backendスモークテスト"]
        AssemblyClient["Whitebase.AssemblyClient<br/>Assemblyスモークテスト"]
        External["External Applications<br/>C#・その他"]
    end

    subgraph Consumers["Bindings / Entry Points"]
        direction LR
        Wasm["whitebase-wasm<br/>WebAssembly境界"]
        TauriCommands["src-tauri<br/>Tauri commands"]
        CApi["whitebase-c-api<br/>C ABI境界"]
    end

    Interface["whitebase-interface<br/>trait・共通型・エラー・能力情報・演算種別"]

    Runner["whitebase-runner<br/>入力生成・ウォームアップ・計測<br/>結果比較・レポート生成"]

    Core["whitebase-core<br/>Backend登録・指定実行<br/>能力・可用性確認・統一計算API"]

    Bridge["whitebase-backend-bridge<br/>各Backendを共通Interfaceへ接続"]

    subgraph Backends["Backend implementations / bindings"]
        direction LR
        RustBackend["whitebase-rust-backend<br/>Rust Scalar / SIMD実装"]
        CppAdapter["whitebase-cpp-adapter<br/>Rust / C++ FFI境界"]
        AsmAdapter["whitebase-asm-adapter<br/>Rust / Assembly FFI境界"]
        Unavailable["unavailable backend<br/>非対応環境用フォールバック"]
    end

    subgraph Native["Native libraries — Windows x64 / MSVC"]
        direction LR
        CppLib["Whitebase.CppBackend.lib<br/>C++ Scalar / AVX"]
        AsmLib["Whitebase.Assembly.lib<br/>MASM x64 Scalar / AVX"]
    end

    subgraph Analysis["Analysis / Output"]
        direction LR
        Visualization["whitebase-visualization<br/>表・グラフ・描画"]
        OutputModule["whitebase-output<br/>CSV・JSON出力"]
        Artifacts["出力データ<br/>CSV・JSON・測定結果"]
        Python["Python tools<br/>追加分析・可視化"]
    end

    subgraph Tools["Development tools"]
        direction LR
        Scripts["scripts / ops.bat<br/>ビルド・テスト・運用"]

        ControlCenter["whitebase-control-center<br/>Rust + egui操作ツール"]

        subgraph Operation["Operation / Control Panel"]
            direction LR
            ControlPanel["whitebase-control-panel<br/>Windows GUI操作パネル"]
            WhitebaseWindows["Whitebase.Windows<br/>Win32 API・プロセス制御"]
        end
    end

    Web -. "planned: browser-only" .-> Wasm
    Web -->|"HTTP"| Server
    TauriApp -->|"IPC / invoke()"| TauriCommands
    Server --> Runner

    CppClient --> CApi
    External --> CApi
    CppBackendClient --> CppLib
    AssemblyClient --> AsmLib

    Wasm -. "current: direct call" .-> RustBackend
    CApi -. "current: direct call" .-> RustBackend

    TauriCommands --> Runner
    Runner --> Core
    Core --> Bridge
    Core -. "uses contract" .-> Interface
    Bridge -. "implements contract" .-> Interface

    Bridge --> RustBackend
    Bridge --> CppAdapter
    Bridge --> AsmAdapter
    Bridge -. "unsupported targets" .-> Unavailable

    CppAdapter --> CppLib
    AsmAdapter --> AsmLib

    Runner -. "planned: report" .-> Visualization
    Runner -. "planned: report" .-> OutputModule
    OutputModule -. "planned: generates" .-> Artifacts
    Python -. "planned: reads / analyzes" .-> Artifacts

    Scripts -. "build / test" .-> Runner
    Scripts -. "build / test" .-> Core
    Scripts -. "build / test" .-> Backends
    Scripts -. "smoke test" .-> CppClient
    Scripts -. "smoke test" .-> CppBackendClient
    Scripts -. "smoke test" .-> AssemblyClient
    Scripts -. "run / release" .-> Server
    Scripts -. "build / release" .-> TauriApp

    ControlCenter -. "operation / check / build" .-> Scripts
    ControlPanel -. "operation / check / build" .-> Scripts
    ControlPanel -->|"Win32 interop / process control"| WhitebaseWindows


